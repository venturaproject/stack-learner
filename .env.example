# PostgreSQL
POSTGRES_DB=boilerplate_learner
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT_EXTERNAL=5445
REDIS_PORT_EXTERNAL=6380
BACKEND_PORT_EXTERNAL=8011
FRONTEND_PORT_EXTERNAL=5174

DB_HOST=postgres
DB_PORT=5432
DB_NAME=boilerplate_learner
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT — change in production!
JWT_SECRET=super-secret-key-change-in-production-minimum-32-chars
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=604800

# Cookie settings
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:8092

# RBAC — comma-separated role names that bypass every permission check.
# Backend (FULL_ACCESS_ROLES) and frontend (VITE_FULL_ACCESS_ROLES) must match.
FULL_ACCESS_ROLES=admin
VITE_FULL_ACCESS_ROLES=admin

# Frontend
VITE_BACKEND_URL=http://localhost:8092
VITE_PUBLIC_API_URL=http://localhost:8092

# Nginx
NGINX_PORT=8092
PROD_NGINX_PORT=8093

# Logging
LOG_LEVEL=debug
